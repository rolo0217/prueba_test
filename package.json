{
  "name": "contact-manager",
  "version": "1.0.0",
  "description": "Contact Manager App with Playwright tests",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:js": "node server.js",
    "dev": "ts-node src/server.ts",
    "test": "playwright test",
    "test:challenge": "playwright test --config=playwright-challenge.config.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/node-fetch": "^2.6.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  }
}
